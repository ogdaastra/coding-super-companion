{
  "name": "neuroform",
  "private": true,
  "version": "0.1.0",
  "description": "NEUROFORM \u2014 a browser-native artificial brain observatory with a Rust/WebAssembly spiking-network engine.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "node scripts/build-wasm.mjs && vite",
    "build": "node scripts/build-wasm.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-wasm.mjs && vitest run",
    "test:engine": "cargo test --manifest-path engine/Cargo.toml",
    "test:e2e": "playwright test",
    "bench:engine": "node scripts/build-wasm.mjs && node scripts/bench-engine.ts",
    "bench:native": "node scripts/bench-native.ts",
    "bench:browser": "node scripts/bench-browser.ts",
    "probe": "node scripts/probe-dynamics.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
